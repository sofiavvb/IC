names(data)!='target'
names(data)[names(data)!='target']
normalize <- function(data){
for(f in names(data)[names(data)!='target']){
range_f = max(data[[f]]) - min(data[[f]])
data[[f]] = (data[[f]] - min(data[[f]]))/range_f
}
data
}
data_org = normalize(data)
